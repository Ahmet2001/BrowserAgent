MODEL_PROVIDER=gemini
OPENAI_COMPAT_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
BASE_MODEL_NAME=gemini-2.5-flash
SUBMODEL_MODEL_NAME=gemma-4-26b-a4b-it
BROWSER_AGENT_MODEL=gemma-4-26b-a4b-it
BASE_REASONING_EFFORT=low
SUBMODEL_REASONING_EFFORT=low
BROWSER_REASONING_EFFORT=low
BROWSER_ACTION_DELAY_SCALE=0.4

TELEGRAM_TOKEN=
GEMINI_API_KEY=
GEMINI_API_KEY_SECONDARY=
DISCORD_TOKEN=
HEARTBEAT_CHAT_ID=
PEXELS_API_KEY=

# --- Bot erisim kontrolu (sayisal kullanici ID'leri, virgulle ayrilmis) ---
# Bota /id (Telegram) veya !id (Discord) yazarak kendi ID'ni ogrenebilirsin.
# ALLOWED tanimli DEGILSE sohbet herkese aciktir (acilista uyarilir).
# ADMIN tanimli DEGILSE uzaktan yonetim komutlari (/agent, /usage, /heartbeat ...) kapalidir.
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_ADMIN_IDS=
DISCORD_ALLOWED_USER_IDS=
DISCORD_ADMIN_IDS=

# --- Operasyon kaydi (log / kosu gecmisi / token kullanimi) ---
# Kayitlarin saklanma suresi (gun). 0 = sinirsiz.
ETHGENT_TELEMETRY_RETENTION_DAYS=30
